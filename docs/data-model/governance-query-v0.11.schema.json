{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "治理目录查询设计契约（尚未接入API）",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "keyword": {
      "type": "string",
      "maxLength": 120
    },
    "directory_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "include_descendants": {
      "type": "boolean"
    },
    "owner_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_is_unassigned": {
      "type": "boolean"
    },
    "knowledge_type_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "maxItems": 20
    },
    "classification_status": {
      "enum": [
        "unclassified",
        "suggested",
        "confirmed"
      ]
    },
    "source_kind": {
      "enum": [
        "local_upload",
        "knowledge_import",
        "agent_delivery",
        "governance_task"
      ]
    },
    "source_agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "file_format": {
      "enum": [
        "txt",
        "md",
        "pdf",
        "docx",
        "xlsx",
        "other"
      ]
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "time_field": {
      "enum": [
        "imported_at",
        "source_modified_at",
        "metadata_updated_at",
        "created_at",
        "updated_at",
        "version_created_at",
        "published_at",
        "valid_from",
        "valid_to",
        "started_at",
        "completed_at",
        "due_at",
        "received_at",
        "enabled_at"
      ]
    },
    "date_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "date_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "timezone": {
      "const": "Asia/Shanghai"
    },
    "sort": {
      "enum": [
        "time_desc",
        "time_asc",
        "name_asc"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "time_field",
    "timezone",
    "sort",
    "limit"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "owner_is_unassigned": {
            "const": true
          }
        },
        "required": [
          "owner_is_unassigned"
        ]
      },
      "then": {
        "properties": {
          "owner_id": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$comment": "Each page must validate allowed time fields/statuses separately; date_from<=date_to and valid dictionary ids are semantic validation."
}
